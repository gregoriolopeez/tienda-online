        <!-- Mensajes de feedback -->
        <?php if (isset($_GET['created'])): ?>
            <div class="alert-msg alert-success">
                ✅ El nuevo producto se ha añadido correctamente al catálogo.
            </div>
        <?php elseif (isset($_GET['updated'])): ?>
            <div class="alert-msg alert-success">
                ✅ El producto se ha actualizado satisfactoriamente.
            </div>
        <?php elseif (isset($_GET['deleted'])): ?>
            <div class="alert-msg alert-success">
                🗑️ El producto ha sido eliminado del catálogo.
            </div>
        <?php elseif (isset($_GET['error'])): ?>
            <div class="alert-msg alert-error">
                ⚠️ Ha ocurrido un error al procesar la solicitud del producto.
            </div>
        <?php endif; ?>

        <?php
        /** @var Product[] $products */
        $products = $products ?? [];
        $totalProducts = count($products);
        $totalStock = 0;
        $totalValue = 0.0;
        $lowStockCount = 0;

        foreach ($products as $p) {
            $stock = intval($p->getStock());
            $price = floatval($p->getPrice());
            $totalStock += $stock;
            $totalValue += ($stock * $price);
            if ($stock <= 5) {
                $lowStockCount++;
            }
        }
        ?>

        <!-- Métricas resumidas de productos -->
        <section class="stats-grid">
            <div class="stat-card">
                <span class="stat-label">Total Productos</span>
                <span class="stat-value" style="color: #38bdf8;"><?= $totalProducts ?></span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Stock en Almacén</span>
                <span class="stat-value" style="color: #a855f7;"><?= $totalStock ?> un.</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Valor en Inventario</span>
                <span class="stat-value" style="color: #34d399;"><?= number_format($totalValue, 2) ?> €</span>
            </div>
            <div class="stat-card">
                <span class="stat-label">Stock Bajo / Agotado (≤ 5)</span>
                <span class="stat-value" style="color: <?= $lowStockCount > 0 ? '#fbbf24' : '#94a3b8' ?>;"><?= $lowStockCount ?></span>
            </div>
        </section>

        <!-- Tabla principal de productos -->
        <section class="table-card">
            <div class="table-header">
                <h2>
                    <span>📋 Listado de Productos</span>
                    <span class="badge-count"><?= $totalProducts ?></span>
                </h2>
                <div class="search-box">
                    <input type="text" id="productSearch" placeholder="Buscar producto por nombre, descripción..." onkeyup="filterProducts()">
                </div>
            </div>

            <div style="overflow-x: auto;">
                <table class="admin-table" id="productsTable">
                    <thead>
                        <tr>
                            <th style="width: 70px;">ID</th>
                            <th>Producto</th>
                            <th style="width: 130px;">Precio</th>
                            <th style="width: 140px;">Stock</th>
                            <th style="width: 200px; text-align: right;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    <?php if (!empty($products)): ?>
                        <?php foreach ($products as $product): ?>
                            <?php
                                $stock = intval($product->getStock());
                                if ($stock <= 0) {
                                    $stockBadgeClass = 'stock-out';
                                    $stockBadgeText = '❌ Agotado (0)';
                                } elseif ($stock <= 5) {
                                    $stockBadgeClass = 'stock-low';
                                    $stockBadgeText = '⚠️ Bajo (' . $stock . ')';
                                } else {
                                    $stockBadgeClass = 'stock-ok';
                                    $stockBadgeText = '✓ ' . $stock . ' uds.';
                                }
                            ?>
                            <tr class="product-row">
                                <td style="color: #94a3b8; font-weight: 700;">#<?= $product->getId() ?></td>
                                <td>
                                    <div class="product-name-desc">
                                        <span class="product-name"><?= htmlspecialchars($product->getName()) ?></span>
                                        <span class="product-desc"><?= htmlspecialchars($product->getDescription() ?: 'Sin descripción detallada') ?></span>
                                    </div>
                                </td>
                                <td>
                                    <span class="price-tag"><?= number_format(floatval($product->getPrice()), 2) ?> €</span>
                                </td>
                                <td>
                                    <span class="stock-badge <?= $stockBadgeClass ?>"><?= $stockBadgeText ?></span>
                                </td>
                                <td>
                                    <div class="action-btns">
                                        <a href="index.php?c=product&edit=<?= $product->getId() ?>" class="btn-action-edit" title="Editar producto">
                                            ✏️ Editar
                                        </a>
                                        <a href="index.php?c=product&delete=<?= $product->getId() ?>" 
                                           class="btn-action-delete" 
                                           title="Eliminar producto"
                                           onclick="return confirm('¿Seguro que deseas eliminar el producto \'<?= addslashes(htmlspecialchars($product->getName())) ?>\'? Esta acción no se puede deshacer.')">
                                            🗑️ Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        <?php endforeach; ?>
                    <?php else: ?>
                        <tr>
                            <td colspan="5" style="text-align: center; padding: 40px; color: #94a3b8;">
                                No se encontraron productos registrados en la base de datos.
                            </td>
                        </tr>
                    <?php endif; ?>
                    </tbody>
                </table>
            </div>
        </section>
    </div>

    <script>
        function filterProducts() {
            const input = document.getElementById('productSearch');
            const filter = input.value.toLowerCase();
            const rows = document.querySelectorAll('.product-row');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                if (text.includes(filter)) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }
    </script>
