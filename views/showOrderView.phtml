<body>
    <div class="cart-container">
        <header class="cart-header">
            <h1>🛒 Carrito de Compras</h1>
            <a href="index.php" class="btn-secondary">🏠 Seguir Comprando</a>
        </header>

        <?php
        /** @var Order|false $order */
        $orderLines = ($order && method_exists($order, 'getOrderLines')) ? $order->getOrderLines() : [];
        ?>

        <?php if (!empty($orderLines)): ?>
            <div class="cart-card">
                <table class="cart-table">
                    <thead>
                        <tr>
                            <th>Producto</th>
                            <th style="width: 110px;">Precio</th>
                            <th style="width: 200px;">Cantidad</th>
                            <th style="width: 110px;">Subtotal</th>
                            <th style="width: 60px; text-align: center;">Quitar</th>
                        </tr>
                    </thead>
                    <tbody>
                    <?php 
                    $totalCalculado = 0;
                    foreach ($orderLines as $ol): 
                        $product = $ol->getProduct();
                        $productName = $product ? htmlspecialchars($product->getName()) : 'Producto #' . $ol->getId();
                        $price = floatval($ol->getPrice());
                        $qty = intval($ol->getQuantity());
                        $subtotal = $price * $qty;
                        $totalCalculado += $subtotal;
                    ?>
                        <tr>
                            <td>
                                <strong><?= $productName ?></strong>
                            </td>
                            <td><?= number_format($price, 2) ?> €</td>
                            <td>
                                <form action="index.php?c=order&update" method="POST" class="qty-form">
                                    <input type="hidden" name="id" value="<?= $ol->getId() ?>">
                                    <input type="number" name="quantity" value="<?= $qty ?>" min="0" class="qty-input">
                                    <button type="submit" class="btn-update">Actualizar</button>
                                </form>
                                <div class="qty-hint">(0 para eliminar)</div>
                            </td>
                            <td style="font-weight: 700; color: #f8fafc;">
                                <?= number_format($subtotal, 2) ?> €
                            </td>
                            <td style="text-align: center;">
                                <a href="index.php?c=order&delete=<?= $ol->getId() ?>" 
                                   class="btn-delete" 
                                   title="Eliminar producto del carrito"
                                   onclick="return confirm('¿Eliminar <?= addslashes($productName) ?> del carrito?')">
                                    🗑️
                                </a>
                            </td>
                        </tr>
                    <?php endforeach; ?>
                    </tbody>
                </table>

                <div class="cart-summary">
                    <div>
                        <span style="color: #94a3b8; font-size: 0.95rem;">Fecha del pedido: </span>
                        <strong><?= htmlspecialchars($order->getDate()) ?></strong>
                    </div>
                    <div style="display: flex; align-items: center; gap: 20px;">
                        <div>
                            <span style="color: #94a3b8; font-size: 0.95rem; margin-right: 8px;">Total:</span>
                            <span class="total-amount"><?= number_format($totalCalculado, 2) ?> €</span>
                        </div>
                    </div>
                </div>
            </div>
        <?php else: ?>
            <div class="cart-card empty-cart">
                <div style="font-size: 3rem; margin-bottom: 12px;">🛒</div>
                <h2>Tu carrito está vacío</h2>
                <p>No tienes ningún producto en tu pedido actual.</p>
                <a href="index.php" class="btn-secondary" style="background: #6366f1; color: #fff;">Explorar Catálogo de Productos</a>
            </div>
        <?php endif; ?>
    </div>
</body>
</html>