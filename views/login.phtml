<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Tienda Online</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <main class="auth-page">
        <div class="auth-card">
            <a href="index.php" class="back-link" id="link-back">
                <span>←</span> Volver a la tienda
            </a>

            <div class="form-header">
                <div class="form-header-icon">🔐</div>
                <h1 class="form-title">Bienvenido</h1>
                <p class="form-subtitle">Inicia sesión para gestionar tus compras y productos</p>
            </div>

            <form action="index.php?c=user" method="POST" id="form-login">
                <div class="form-group">
                    <label for="username" class="form-label">Nombre de usuario o Email</label>
                    <input 
                        type="text" 
                        name="username" 
                        id="username" 
                        class="form-control" 
                        placeholder="tu_nombre o email@ejemplo.com" 
                        required
                        autocomplete="username"
                    >
                </div>

                <div class="form-group">
                    <label for="password" class="form-label">Contraseña</label>
                    <input 
                        type="password" 
                        name="password" 
                        id="password" 
                        class="form-control" 
                        placeholder="••••••••" 
                        required
                        autocomplete="current-password"
                    >
                </div>

                <button type="submit" name="login" value="1" class="btn btn-primary btn-block" id="btn-submit-login">
                    Iniciar Sesión
                </button>
            </form>

            <div class="form-footer">
                ¿Aún no tienes cuenta? 
                <a href="index.php?register" id="link-register">Regístrate gratis</a>
            </div>
        </div>
    </main>

</body>
</html>