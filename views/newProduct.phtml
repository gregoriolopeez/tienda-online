<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Subir Producto - Tienda Online</title>
    <link rel="stylesheet" href="css/style.css">
</head>
<body>

    <main class="auth-page">
        <div class="auth-card" style="max-width: 540px;">
            <a href="index.php" class="back-link" id="link-back">
                <span>←</span> Volver a la tienda
            </a>

            <div class="form-header">
                <div class="form-header-icon">📦</div>
                <h1 class="form-title">Subir Producto</h1>
                <p class="form-subtitle">Añade un nuevo artículo al catálogo de la tienda</p>
            </div>

            <form action="index.php?c=product&add" method="POST" id="form-new-product">
                <div class="form-group">
                    <label for="name" class="form-label">Nombre del Producto</label>
                    <input 
                        type="text" 
                        name="name" 
                        id="name" 
                        class="form-control" 
                        placeholder="Ej. Teclado Mecánico RGB" 
                        required
                    >
                </div>

                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                    <div class="form-group">
                        <label for="price" class="form-label">Precio (€)</label>
                        <input 
                            type="number" 
                            name="price" 
                            id="price" 
                            class="form-control" 
                            placeholder="29.99" 
                            step="0.01" 
                            min="0" 
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="stock" class="form-label">Unidades en Stock</label>
                        <input 
                            type="number" 
                            name="stock" 
                            id="stock" 
                            class="form-control" 
                            placeholder="10" 
                            min="0" 
                            value="1" 
                            required
                        >
                    </div>
                </div>

                <div class="form-group">
                    <label for="description" class="form-label">Descripción del Producto</label>
                    <textarea 
                        name="description" 
                        id="description" 
                        class="form-control" 
                        rows="4" 
                        placeholder="Detalles sobre las características, estado y especificaciones del producto..."
                    ></textarea>
                </div>

                <button type="submit" name="add" class="btn btn-primary btn-block" id="btn-submit-product">
                    Publicar Producto
                </button>
            </form>
        </div>
    </main>

</body>
</html>