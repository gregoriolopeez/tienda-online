        /** @var User[] $users */
        $users = $users ?? [];
        $totalUsers = count($users);
        $totalAdmins = 0;
        $totalStandard = 0;
        foreach ($users as $u) {
            if ($u->isAdmin()) {
                $totalAdmins++;
            } else {
                $totalStandard++;
            }
        }
        $currentUserId = isset($_SESSION['user']) ? $_SESSION['user']->getId() : null;
        ?>

        <!-- Tarjetas de estadísticas -->
        <section class="stats-grid">
            <div class="stat-card">
                <span class="stat-label">Total Usuarios</span>
